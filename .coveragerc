[run]
# Coverage misurata solo sui moduli con test affidabili (non-GUI).
# I file GUI sono esclusi: richiedono QApplication + DB live + interazione
# utente, e i loro numeri di coverage sarebbero fuorvianti.
source =
    catasto_db_manager
    app_utils
    app_paths
    config
    validators
    db
    core
    api
    utils
    foliarium

omit =
    tests/*
    sql_scripts/*
    resources/*
    */site-packages/*
    */__pycache__/*
    generate_license.py
    setup_database.py
    setup_db.py
    prepare_demo_db.py
    migrate_database.py

[report]
show_missing = True
precision = 2
skip_empty = True
fail_under = 70

[html]
directory = coverage_html
title = Foliarium - Coverage Report

[xml]
output = coverage.xml
