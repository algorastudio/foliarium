{
  "name": "Meridiana – Catasto Storico",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "meridiana",
      "webPort": 6080
    }
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "forwardPorts": [5432, 6080, 5173, 8765],
  "portsAttributes": {
    "6080": {
      "label": "Desktop GUI (noVNC)",
      "onAutoForward": "openBrowser"
    },
    "5432": {
      "label": "PostgreSQL"
    },
    "5173": {
      "label": "React Dev Server",
      "onAutoForward": "openBrowser"
    },
    "8765": {
      "label": "FastAPI",
      "onAutoForward": "silent"
    }
  },

  "containerEnv": {
    "DISPLAY": ":1",
    "QT_QPA_PLATFORM": "xcb",
    "PGHOST": "localhost",
    "PGPORT": "5432",
    "PGUSER": "postgres",
    "PGPASSWORD": "postgres",
    "PGDATABASE": "catasto_storico",
    "DB_HOST": "localhost",
    "DB_USER": "postgres",
    "DB_PASS": "postgres",
    "DB_NAME": "catasto_storico",
    "DB_PORT": "5432"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.pylint",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
