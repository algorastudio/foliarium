/* ============================================================
   Foliarium — Tema Magistrale  (Purple Warm)
   Ispirato al mockup Meridiana v2 / Archivio di Stato di Savona
   Colori:
     Primary        #534AB7  (Purple)
     Primary dark   #3C3489  (Purple dark)
     Primary light  #EEEDFE  (Purple light)
     Purple border  #AFA9EC
     Surface        #FFFFFF
     Background     #F5F4F0  (crema calda)
     Content bg     #EEEДЕ8  → #EDEAE3 (approssimato)
     Text           #1A1A18
     Text secondary #5F5E5A
     Border         #E0DDD7  (rgba(0,0,0,0.12) su crema)
     Border medium  #C8C5BE  (rgba(0,0,0,0.22) su crema)
   ============================================================ */

/* ── Base ── */
QWidget {
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 10pt;
    color: #1A1A18;
    background-color: #F5F4F0;
}
QMainWindow, QDialog {
    background-color: #F5F4F0;
}
QLabel {
    color: #1A1A18;
    background-color: transparent;
    padding: 1px;
}

/* ── Input fields ── */
QLineEdit, QTextEdit, QPlainTextEdit,
QSpinBox, QDoubleSpinBox,
QDateEdit, QDateTimeEdit, QComboBox {
    background-color: #FFFFFF;
    color: #1A1A18;
    border: 1px solid #C8C5BE;
    border-radius: 8px;
    padding: 5px 10px;
    min-height: 28px;
    selection-background-color: #534AB7;
    selection-color: #FFFFFF;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus,
QDateEdit:focus, QDateTimeEdit:focus, QComboBox:focus {
    border: 1.5px solid #534AB7;
    background-color: #FDFCFF;
}
QLineEdit[readOnly="true"], QTextEdit[readOnly="true"],
QPlainTextEdit[readOnly="true"] {
    background-color: #F5F4F0;
    color: #3C3489;
    border-color: #E0DDD7;
}
QLineEdit::placeholder { color: #9B9894; }

/* ── Buttons (default = secondary outlined) ── */
QPushButton {
    background-color: #FFFFFF;
    color: #1A1A18;
    border: 1px solid #C8C5BE;
    border-radius: 8px;
    padding: 7px 16px;
    font-weight: 500;
    min-width: 80px;
    min-height: 30px;
}
QPushButton:hover    { background-color: #F5F4F0; border-color: #A8A5A0; }
QPushButton:pressed  { background-color: #EDEAE3; }
QPushButton:disabled { background-color: #F0EDE8; color: #AEABA6; border-color: #E0DDD7; }

/* Primary button */
QPushButton[flat="false"]:not(#secondaryButton):not(#navButton):not(#logoutButton) {
    /* non possiamo selezionare "primary" in QSS, usiamo naming esplicito */
}
QPushButton#primaryButton {
    background-color: #534AB7;
    color: #FFFFFF;
    border-color: #534AB7;
    font-weight: 600;
}
QPushButton#primaryButton:hover  { background-color: #3C3489; border-color: #3C3489; }
QPushButton#primaryButton:pressed { background-color: #2D2677; }

/* Secondary / flat button */
QPushButton[flat="true"],
QPushButton#secondaryButton {
    background-color: transparent;
    color: #534AB7;
    border: 1px solid #C8C5BE;
}
QPushButton[flat="true"]:hover,
QPushButton#secondaryButton:hover {
    background-color: #EEEDFE;
    border-color: #AFA9EC;
    color: #3C3489;
}

/* ── Tabs ── */
QTabWidget::pane {
    border-top: 1px solid #E0DDD7;
    background-color: #FFFFFF;
}
QTabBar::tab {
    background: transparent;
    color: #5F5E5A;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 8px 14px;
    margin-right: 2px;
    font-size: 10pt;
}
QTabBar::tab:hover   { color: #1A1A18; }
QTabBar::tab:selected {
    color: #1A1A18;
    font-weight: 600;
    border-bottom: 2px solid #534AB7;
}

/* ── Tables ── */
QTableWidget, QTreeWidget, QListWidget {
    gridline-color: #E0DDD7;
    background-color: #FFFFFF;
    alternate-background-color: #F9F8F5;
    selection-background-color: #AFA9EC;
    selection-color: #1A1A18;
    border: 1px solid #E0DDD7;
    border-radius: 8px;
}
QHeaderView::section {
    background-color: #F5F4F0;
    color: #5F5E5A;
    padding: 6px 8px;
    border: none;
    border-right: 1px solid #E0DDD7;
    border-bottom: 1px solid #E0DDD7;
    font-weight: 600;
    font-size: 9pt;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
QTableWidget::item:selected, QTreeWidget::item:selected {
    background-color: #EEEDFE;
    color: #1A1A18;
}

/* ── GroupBox (card style) ── */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #E0DDD7;
    border-radius: 12px;
    margin-top: 1.8ex;
    padding: 14px 12px 12px 12px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 0 6px;
    color: #534AB7;
    font-size: 10pt;
    font-weight: 600;
}

/* ── ComboBox ── */
QComboBox::drop-down { border: none; background: transparent; width: 22px; }
QComboBox::down-arrow { width: 12px; height: 12px; }
QComboBox QAbstractItemView {
    border: 1px solid #C8C5BE;
    border-radius: 8px;
    selection-background-color: #534AB7;
    selection-color: #FFFFFF;
    background-color: #FFFFFF;
    padding: 2px;
}

/* ── CheckBox / RadioButton ── */
QCheckBox { spacing: 6px; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px; height: 16px;
    border: 1.5px solid #AFA9EC;
    border-radius: 4px;
    background-color: #FFFFFF;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #534AB7;
    border-color: #3C3489;
}
QRadioButton::indicator { border-radius: 8px; }

/* ── ScrollBar ── */
QScrollBar:vertical {
    border: none;
    background: #EDEAE3;
    width: 8px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #C8C5BE;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #AFA9EC; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    border: none;
    background: #EDEAE3;
    height: 8px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #C8C5BE;
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover { background: #AFA9EC; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ── Splitter ── */
QSplitter::handle { background: #E0DDD7; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical   { height: 1px; }

/* ── StatusBar ── */
QStatusBar { background-color: #EDEAE3; color: #5F5E5A; font-size: 9pt; }

/* ── Menu ── */
QMenuBar            { background-color: #FFFFFF; color: #1A1A18; border-bottom: 1px solid #E0DDD7; }
QMenuBar::item:selected { background: #EEEDFE; color: #534AB7; border-radius: 4px; }
QMenu               { background-color: #FFFFFF; border: 1px solid #C8C5BE; border-radius: 8px; color: #1A1A18; padding: 4px; }
QMenu::item         { padding: 7px 20px; border-radius: 6px; }
QMenu::item:selected { background-color: #534AB7; color: #FFFFFF; }
QMenu::separator    { height: 1px; background: #E0DDD7; margin: 4px 0; }

/* ── ProgressBar ── */
QProgressBar {
    border: 1px solid #E0DDD7;
    border-radius: 6px;
    background: #EDEAE3;
    text-align: center;
    color: #534AB7;
    font-weight: 600;
    height: 16px;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #534AB7, stop:1 #3C3489);
    border-radius: 5px;
}

/* ── ToolTip ── */
QToolTip {
    background-color: #3C3489;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 9pt;
}

/* ── SpinBox arrows ── */
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background: transparent;
    border: none;
    width: 16px;
}

/* ============================================================
   TOPBAR
   ============================================================ */
#topBar {
    background: #FFFFFF;
    border-bottom: 1px solid #E0DDD7;
    min-height: 52px;
    max-height: 52px;
}
#appTitle {
    font-size: 14px;
    font-weight: 600;
    color: #1A1A18;
    letter-spacing: -0.3px;
}
#appSubtitle {
    font-size: 12px;
    color: #5F5E5A;
    margin-left: 2px;
}
#dbIndicator { font-size: 10px; color: #5F5E5A; }
#userLabel   { font-size: 11px; color: #1A1A18; font-weight: 500; }

#avatarWidget {
    border-radius: 14px;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    background: #E6F1FB;
    color: #185FA5;
    font-size: 10px;
    font-weight: 600;
    qproperty-alignment: AlignCenter;
}

#roleChip {
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 10px;
    font-weight: 600;
}
#roleChip[role="admin"]        { background: #FCEBEB; color: #A32D2D; }
#roleChip[role="archivista"]   { background: #EEEDFE; color: #3C3489; }
#roleChip[role="consultatore"] { background: #F5F4F0; color: #4A4A48; }

#logoutButton {
    background: transparent;
    border: 1px solid #C8C5BE;
    border-radius: 8px;
    padding: 4px 14px;
    color: #5F5E5A;
    font-size: 11px;
    font-weight: 500;
    min-width: 60px;
    min-height: 28px;
}
#logoutButton:hover {
    background: #EEEDFE;
    border-color: #AFA9EC;
    color: #534AB7;
}

/* ── Badge demo ── */
#demoBadge {
    background: #E65100;
    color: white;
    font-weight: bold;
    font-size: 10px;
    border-radius: 4px;
    padding: 2px 6px;
}

/* ── Version/badge chip in topbar ── */
#versionBadge {
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 8px;
    background: #F5F4F0;
    color: #5F5E5A;
    border: 1px solid #E0DDD7;
}

/* ============================================================
   TOP NAV (sezioni orizzontali)
   ============================================================ */
#topNav {
    background: #FFFFFF;
    border-bottom: 1px solid #E0DDD7;
    min-height: 44px;
    max-height: 44px;
}
QPushButton#topNavButton {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0;
    color: #5F5E5A;
    font-size: 13px;
    font-weight: 500;
    padding: 0 16px;
    min-width: 0;
    min-height: 44px;
    margin: 0;
}
QPushButton#topNavButton:hover { color: #1A1A18; }
QPushButton#topNavButton[active="true"] {
    color: #1A1A18;
    font-weight: 600;
    border-bottom: 2px solid #534AB7;
}

/* ============================================================
   SUB NAV (pagine per sezione)
   ============================================================ */
#subNav {
    background: #F5F4F0;
    border-bottom: 1px solid #E0DDD7;
    min-height: 36px;
    max-height: 36px;
}
QPushButton#subNavButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #5F5E5A;
    font-size: 12px;
    font-weight: 400;
    padding: 4px 12px;
    min-width: 0;
    min-height: 28px;
    margin: 4px 2px;
}
QPushButton#subNavButton:hover {
    background: #EEEDFE;
    color: #534AB7;
}
QPushButton#subNavButton[active="true"] {
    background: #EEEDFE;
    color: #534AB7;
    font-weight: 600;
}

/* ============================================================
   SIDEBAR (legacy — non più usata nel layout principale)
   ============================================================ */
#sidebar {
    background: #FFFFFF;
    border-right: 1px solid #E0DDD7;
    min-width: 220px;
    max-width: 220px;
}
#sectionLabel {
    color: #AFA9EC;
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    padding: 14px 16px 4px 16px;
    background: transparent;
}
QPushButton#navButton {
    text-align: left;
    padding: 9px 12px 9px 14px;
    border: none;
    border-radius: 8px;
    margin: 1px 8px;
    background: transparent;
    color: #5F5E5A;
    font-size: 12px;
    font-weight: 500;
    icon-size: 16px;
}
QPushButton#navButton:hover {
    background: #F5F4F0;
    color: #1A1A18;
}
QPushButton#navButton[active="true"] {
    background: #EEEDFE;
    color: #534AB7;
    font-weight: 600;
    border-left: 3px solid #534AB7;
    padding-left: 11px;
}

/* ============================================================
   CONTENT AREA
   ============================================================ */
QStackedWidget { background: #EDEAE3; }

/* ============================================================
   OFFLINE / WARNING BARS
   ============================================================ */
#offlineBar {
    background: #FCEBEB;
    border-bottom: 1px solid #F0B8B8;
    color: #A32D2D;
    font-weight: 600;
    padding: 6px 16px;
}
#staleDataBar {
    background: #FFF8E1;
    border-bottom: 1px solid #FFE082;
    color: #E65100;
    font-weight: 600;
    padding: 6px 16px;
}

/* ============================================================
   FILTER CHIPS (usati nelle ricerche)
   ============================================================ */
QPushButton#filterChip {
    background: #FFFFFF;
    border: 1px solid #E0DDD7;
    border-radius: 8px;
    color: #5F5E5A;
    font-size: 11px;
    padding: 4px 10px;
    min-width: 0;
    min-height: 0;
    font-weight: 400;
}
QPushButton#filterChip:hover {
    border-color: #C8C5BE;
    color: #1A1A18;
}
QPushButton#filterChip[active="true"] {
    background: #EEEDFE;
    border-color: #AFA9EC;
    color: #3C3489;
    font-weight: 500;
}

/* ============================================================
   RESULT CARDS (nelle viste di ricerca)
   ============================================================ */
QFrame#resultCard {
    background: #FFFFFF;
    border: 1px solid #E0DDD7;
    border-radius: 8px;
}
QFrame#resultCard:hover {
    border-color: #C8C5BE;
}

/* ── Year badge nelle result card ── */
QLabel#yearBadge {
    font-size: 11px;
    font-weight: 600;
    color: #534AB7;
    background: #EEEDFE;
    border-radius: 4px;
    padding: 3px 7px;
}

/* ============================================================
   AUDIT LOG ITEMS
   ============================================================ */
QFrame#auditItem {
    background: #FFFFFF;
    border: 1px solid #E0DDD7;
    border-radius: 8px;
}

QLabel#auditIcon {
    border-radius: 6px;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    qproperty-alignment: AlignCenter;
    font-size: 12px;
}
QLabel#auditIcon[type="view"]   { background: #E6F1FB; color: #185FA5; }
QLabel#auditIcon[type="edit"]   { background: #FAEEDA; color: #854F0B; }
QLabel#auditIcon[type="export"] { background: #EAF3DE; color: #3B6D11; }
QLabel#auditIcon[type="delete"] { background: #FCEBEB; color: #A32D2D; }

/* ============================================================
   STATUS CHIPS
   ============================================================ */
QLabel#statusChip {
    font-size: 11px;
    font-weight: 600;
    border-radius: 4px;
    padding: 2px 7px;
}
QLabel#statusChip[status="ok"]    { background: #EAF3DE; color: #3B6D11; }
QLabel#statusChip[status="warn"]  { background: #FAEEDA; color: #854F0B; }
QLabel#statusChip[status="error"] { background: #FCEBEB; color: #A32D2D; }

/* ============================================================
   METRIC CARDS (dashboard)
   ============================================================ */
QFrame#metricCard {
    background: #FFFFFF;
    border: 1px solid #E0DDD7;
    border-radius: 8px;
}
QLabel#metricValue {
    font-size: 22px;
    font-weight: 500;
    color: #1A1A18;
}
QLabel#metricLabel {
    font-size: 11px;
    color: #5F5E5A;
}
QLabel#metricSub {
    font-size: 10px;
    color: #9B9894;
}

/* ============================================================
   TIMELINE (genealogia / storia proprietà)
   ============================================================ */
QFrame#timelineItem {
    background: transparent;
    border: none;
    border-left: 2px solid #E0DDD7;
    padding-left: 16px;
}
QLabel#timelineDate {
    font-size: 11px;
    color: #5F5E5A;
    min-width: 42px;
}
QLabel#timelineDot {
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
    border-radius: 4px;
    background: #534AB7;
}
