/* Stile "Grigio Ardesia" (Dark) */
QWidget {
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 10pt;
    color: #ECF0F1; /* Testo grigio chiaro */
}

QMainWindow, QDialog, QGroupBox {
    background-color: #2C3E50; /* Sfondo principale grigio/blu scuro */
}

QGroupBox {
    font-weight: bold;
    border: 1px solid #4A6572; /* Bordo grigio-blu */
    border-radius: 8px;
    margin-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    left: 10px;
}

QLineEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QComboBox {
    background-color: #34495E; /* Sfondo widget più chiaro */
    border: 1px solid #4A6572;
    border-radius: 4px;
    padding: 5px;
    color: #ECF0F1;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QComboBox:focus {
    border-color: #5DADE2; /* Blu accento per il focus */
}

QPushButton {
    background-color: #5DADE2; /* Blu accento */
    color: #212529; /* Testo scuro per leggibilità sul blu chiaro */
    font-weight: bold;
    border: none;
    border-radius: 4px;
    padding: 8px 12px;
    min-width: 100px;
}

QPushButton:hover {
    background-color: #85C1E9;
}

QPushButton:pressed {
    background-color: #3498DB;
}

QPushButton:disabled {
    background-color: #566573;
    color: #99A3A4;
}

QTabWidget::pane {
    border-top: 2px solid #4A6572;
    padding: 10px;
}

QTabBar::tab {
    background: #34495E;
    border: 1px solid #4A6572;
    border-bottom: none;
    padding: 8px 15px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background: #2C3E50;
    border-color: #5DADE2;
    font-weight: bold;
}

QTableWidget {
    border: 1px solid #4A6572;
    gridline-color: #34495E;
    background-color: #34495E;
}

QHeaderView::section {
    background-color: #4A6572; /* Header tabelle leggermente più chiaro */
    padding: 5px;
    border: 1px solid #2C3E50;
    font-weight: bold;
}

QTableWidget::item:selected {
    background-color: #5DADE2;
    color: #212529;
}
/* === TOPBAR & SIDEBAR v1.5.0 === */
#topBar {
    background: #263443;
    border-bottom: 1px solid #4A6278;
    min-height: 48px;
    max-height: 48px;
}
#appTitle { font-size: 15px; font-weight: bold; color: #ECF0F1; }
#dbIndicator { font-size: 11px; color: #B0BEC5; }
#userLabel { font-size: 12px; color: #ECF0F1; }
#roleChip[role="admin"]        { background: #4A1020; color: #FF8A80; border-radius: 10px; padding: 2px 8px; font-size: 11px; }
#roleChip[role="archivista"]   { background: #1A3A55; color: #5DADE2; border-radius: 10px; padding: 2px 8px; font-size: 11px; }
#roleChip[role="consultatore"] { background: #34495E; color: #B0BEC5; border-radius: 10px; padding: 2px 8px; font-size: 11px; }
#logoutButton { background: transparent; border: 1px solid #4A6278; border-radius: 4px; padding: 4px 12px; color: #ECF0F1; font-size: 12px; }
#logoutButton:hover { background: #34495E; border-color: #5DADE2; }
#sidebar { background: #263443; border-right: 1px solid #4A6278; min-width: 220px; max-width: 220px; }
#sectionLabel { color: #7F8C8D; font-size: 10px; font-weight: bold; text-transform: uppercase; padding: 12px 16px 4px 16px; background: transparent; }
QPushButton#navButton { text-align: left; padding: 8px 16px; border: none; border-radius: 6px; margin: 1px 8px; background: transparent; color: #ECF0F1; font-size: 13px; }
QPushButton#navButton:hover { background: #34495E; }
QPushButton#navButton[active="true"] { background: #1A3A55; color: #5DADE2; font-weight: bold; border-left: 3px solid #5DADE2; }
QStackedWidget { background: #2C3E50; }
