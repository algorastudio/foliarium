/* Stile "Verde Archivio" - Versione ottimizzata con tab abbreviati */
QWidget {
    font-family: 'Roboto', 'Arial', sans-serif;
    font-size: 10pt;
    color: #1B5E20;
}

QMainWindow, QDialog {
    background-color: #F1F8E9;
}

QGroupBox {
    font-weight: bold;
    border: 1px solid #689F38;
    border-radius: 5px;
    margin-top: 10px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 10px;
    left: 20px;
    color: #33691E;
}

QLineEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #AED581;
    border-radius: 3px;
    padding: 5px 8px;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QComboBox:focus {
    border-color: #689F38;
    border-width: 2px;
}

QPushButton {
    background-color: #689F38;
    color: white;
    font-weight: bold;
    border: none;
    border-radius: 3px;
    padding: 8px 15px;
    min-width: 100px;
}

QPushButton:hover {
    background-color: #558B2F;
}

QPushButton:pressed {
    background-color: #33691E;
}

QPushButton:disabled {
    background-color: #C5E1A5;
    color: #E8F5E9;
}

QTabWidget::pane {
    border: 1px solid #689F38;
    padding: 10px;
    background-color: #FFFFFF;
}

/* TAB OTTIMIZZATI CON GRASSETTO */
QTabBar::tab {
    background: #DCEDC8;
    border: 1px solid #AED581;
    border-bottom: none;
    padding: 10px 18px;
    min-width: 70px;
    min-height: 20px;
    margin-right: 2px;
    text-align: center;
}

QTabBar::tab:selected {
    background: #FFFFFF;
    border-color: #689F38;
    font-weight: bold;
    color: #33691E;
    border-top: 3px solid #558B2F;
    padding-top: 8px;
}

QTabBar::tab:hover:!selected {
    background: #C5E1A5;
    color: #33691E;
}

/* Tab principali - più spaziosi */
QTabWidget > QTabBar::tab {
    min-width: 90px;
    padding: 10px 20px;
}

/* Sotto-tab - più compatti */
QTabWidget QTabWidget QTabBar::tab {
    min-width: 70px;
    padding: 8px 15px;
    font-size: 9pt;
}

/* Tab con icone emoji */
QTabBar::tab[text*="🏠"], 
QTabBar::tab[text*="🔍"], 
QTabBar::tab[text*="📤"] {
    padding-left: 15px;
    padding-right: 15px;
}

QTableWidget {
    border: 1px solid #AED581;
    gridline-color: #DCEDC8;
    background-color: #FFFFFF;
}

QHeaderView::section {
    background-color: #8BC34A;
    padding: 5px;
    border: none;
    font-weight: bold;
    color: white;
}

QTableWidget::item:selected {
    background-color: #9CCC65;
    color: white;
}

QTableWidget::item:alternate {
    background-color: #F1F8E9;
}

QTabWidget QPushButton {
    padding: 6px 12px;
    min-height: 30px;
}

QToolTip {
    background-color: #DCEDC8;
    border: 1px solid #689F38;
    padding: 5px;
    border-radius: 3px;
    color: #1B5E20;
}
/* ── v1.5 Navigation (TopBar + Sidebar) ── */
#topBar {
    background: #2D5016;
    border-bottom: 1px solid #3D6B1F;
    min-height: 48px;
    max-height: 48px;
}
#appTitle { font-size: 15px; font-weight: bold; color: #F1F8E9; }
#dbIndicator { font-size: 11px; color: #A5D6A7; }
#userLabel { font-size: 12px; color: #F1F8E9; }
#roleChip { border-radius: 4px; padding: 2px 8px; font-size: 11px; font-weight: bold; }
#roleChip[role="admin"]        { background: #5A1A1A; color: #EF9A9A; }
#roleChip[role="archivista"]   { background: #1B5E20; color: #A5D6A7; }
#roleChip[role="consultatore"] { background: #33691E; color: #C5E1A5; }
#logoutButton {
    background: transparent;
    border: 1px solid #689F38;
    color: #F1F8E9;
    border-radius: 4px;
    padding: 4px 12px;
}
#logoutButton:hover { background: #3D6B1F; }
#sidebar {
    background: #1B3A0D;
    border-right: 1px solid #3D6B1F;
    min-width: 220px;
    max-width: 220px;
}
#sectionLabel {
    color: #81C784;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 12px 16px 4px;
}
QPushButton#navButton {
    text-align: left;
    padding: 8px 16px;
    margin: 1px 8px;
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #C5E1A5;
    font-size: 13px;
}
QPushButton#navButton:hover { background: #2D5016; }
QPushButton#navButton[active="true"] {
    background: #1B5E20;
    color: #A5D6A7;
    font-weight: bold;
    border-left: 3px solid #689F38;
}
QStackedWidget { background: #162B0A; }
