/* Stile "Blu Savoia" - Versione ottimizzata con tab abbreviati */
QWidget {
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 10pt;
    color: #212529;
}

QMainWindow, QDialog {
    background-color: #F8F9FA;
}

QGroupBox {
    font-weight: bold;
    border: 1px solid #D3D3D3;
    border-radius: 8px;
    margin-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    left: 10px;
}

QLineEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 5px;
    min-height: 28px;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QComboBox:focus {
    border-color: #357EC7;
}

QPushButton {
    background-color: #357EC7;
    color: white;
    font-weight: bold;
    border: none;
    border-radius: 4px;
    padding: 8px 12px;
    min-width: 100px;
}

QPushButton:hover {
    background-color: #2a6ead;
}

QPushButton:pressed {
    background-color: #215a8c;
}

QPushButton:disabled {
    background-color: #A9A9A9;
    color: #303030; /* era #E0E0E0: testo chiaro su grigio medio (1.8:1 → 6.8:1) */
}

QTabWidget::pane {
    border-top: 2px solid #D3D3D3;
    padding: 10px;
    background-color: #FFFFFF;
}

/* TAB OTTIMIZZATI CON GRASSETTO */
QTabBar::tab {
    background: #E9ECEF;
    border: 1px solid #D3D3D3;
    border-bottom: none;
    /* Padding bilanciato per i nomi abbreviati */
    padding: 10px 18px;
    /* Larghezza minima appropriata per tab corti */
    min-width: 70px;
    /* Altezza uniforme */
    min-height: 20px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    /* Spazio tra i tab */
    margin-right: 2px;
    /* Allineamento centrale del testo */
    text-align: center;
}

QTabBar::tab:selected {
    background: #FFFFFF;
    border-color: #D3D3D3;
    /* Ripristina il grassetto per il tab selezionato */
    font-weight: bold;
    /* Colore blu per evidenziare */
    color: #357EC7;
    /* Bordo superiore colorato */
    border-top: 3px solid #357EC7;
    /* Compensa il bordo più spesso */
    padding-top: 8px;
}

QTabBar::tab:hover:!selected {
    background: #F0F0F0;
    /* Colore più scuro al passaggio del mouse */
    color: #357EC7;
}

/* Differenziazione per tab principali e sotto-tab */
/* Tab principali - più spaziosi */
QTabWidget > QTabBar::tab {
    min-width: 90px;
    padding: 10px 20px;
}

/* Sotto-tab - più compatti */
QTabWidget QTabWidget QTabBar::tab {
    min-width: 70px;
    padding: 8px 15px;
    font-size: 9pt;
}

/* Stile specifico per i tab con icone emoji */
QTabBar::tab[text*="🏠"], 
QTabBar::tab[text*="🔍"], 
QTabBar::tab[text*="📤"] {
    /* Padding extra per bilanciare le icone */
    padding-left: 15px;
    padding-right: 15px;
}

QTableWidget {
    border: 1px solid #D3D3D3;
    gridline-color: #E0E0E0;
    background-color: #FFFFFF;
}

QHeaderView::section {
    background-color: #E6F7FF;
    padding: 5px;
    border: 1px solid #D3D3D3;
    font-weight: bold;
}

QTableWidget::item:selected {
    background-color: #7FB3D5;
    color: white;
}

/* Stile per i pulsanti nei tab (come "Aggiorna Statistiche Comuni") */
QTabWidget QPushButton {
    padding: 6px 12px;
    min-height: 30px;
}

/* Migliora l'aspetto dei tooltip */
QToolTip {
    background-color: #FFFBDD;
    border: 1px solid #D3D3D3;
    padding: 5px;
    border-radius: 3px;
    color: #000000;
}
/* ── v1.5 Navigation (TopBar + Sidebar) ── */
#topBar {
    background: #EEF4FA;
    border-bottom: 1px solid #A8C8E0;
    min-height: 48px;
    max-height: 48px;
}
#appTitle { font-size: 15px; font-weight: bold; color: #1E3A5F; }
#dbIndicator { font-size: 11px; color: #1E5A96; }
#userLabel { font-size: 12px; color: #1E3A5F; }
#roleChip { border-radius: 4px; padding: 2px 8px; font-size: 11px; font-weight: bold; }
#roleChip[role="admin"]        { background: #FFEBEE; color: #8B1A1A; }
#roleChip[role="archivista"]   { background: #D5E8F5; color: #1E3A5F; }
#roleChip[role="consultatore"] { background: #EEF4FA; color: #1E5A96; }
#logoutButton {
    background: transparent;
    border: 1px solid #A8C8E0;
    color: #1E3A5F;
    border-radius: 4px;
    padding: 4px 12px;
}
#logoutButton:hover { background: #D5E8F5; }
#sidebar {
    background: #D5E8F5;
    border-right: 1px solid #A8C8E0;
    min-width: 220px;
    max-width: 220px;
}
#sectionLabel {
    color: #1E5A96;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 12px 16px 4px;
}
QPushButton#navButton {
    text-align: left;
    padding: 8px 16px;
    margin: 1px 8px;
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #1E3A5F;
    font-size: 13px;
}
QPushButton#navButton:hover { background: #B8D4E8; }
QPushButton#navButton[active="true"] {
    background: #1E5A96;
    color: #FFFFFF;
    font-weight: bold;
    border-left: 3px solid #1E3A5F;
}
QStackedWidget { background: #F5F9FD; }

/* Form validation error state — gestito da _set_field_error() */
QLineEdit[error="true"], QTextEdit[error="true"], QPlainTextEdit[error="true"],
QComboBox[error="true"], QDateEdit[error="true"], QSpinBox[error="true"] {
    border: 1.5px solid #e74c3c;
}

/* Info box per riepiloghi (partita sorgente/destinazione, etc.) */
QLabel#infoBox {
    padding: 5px 8px;
    border: 1px solid palette(mid);
    border-radius: 4px;
    background: palette(alternate-base);
    min-height: 1.6em;
}

/* Titolo step wizard partita/operazioni */
QLabel#wizardStepTitle {
    font-size: 14pt;
    font-weight: 600;
    color: palette(highlight);
}

/* Status text labels (download, SMTP test, ecc.) */
QLabel[status="pending"] { color: palette(mid); }
QLabel[status="success"] { color: #27ae60; }
QLabel[status="warning"] { color: #e67e22; }
QLabel[status="error"]   { color: #c0392b; }

/* Hint/note labels (italic, colore secondario) */
QLabel#hintLabel { font-style: italic; color: palette(mid); }

/* DB connection indicator badge */
QLabel#dbIndicator {
    font-size: 11px;
    border-radius: 10px;
    padding: 2px 8px;
    font-weight: 600;
}
QLabel#dbIndicator[dbStatus="connected"] { color: #2E7D32; background: #E8F5E9; }
QLabel#dbIndicator[dbStatus="offline"]   { color: #B71C1C; background: #FDE8E8; }

/* License expiry chip */
QLabel#licenseExpiryChip {
    border-radius: 4px;
    font-size: 11px;
    font-weight: bold;
    padding: 2px 6px;
    color: white;
}
QLabel#licenseExpiryChip[severity="expired"]  { background: #B71C1C; }
QLabel#licenseExpiryChip[severity="critical"] { background: #E65100; }
QLabel#licenseExpiryChip[severity="warning"]  { background: #F57F17; }

/* Step bar wizard (barra avanzamento step) */
QLabel[stepState="current"] {
    font-weight: 700;
    color: palette(highlight);
    text-decoration: underline;
}
QLabel[stepState="done"]    { color: #4CAF50; }
QLabel[stepState="pending"] { color: palette(mid); }

/* Stato partita badge */
QLabel#statoBadge {
    border-radius: 9px;
    padding: 1px 9px;
    font-size: 9pt;
    font-weight: 600;
}
QLabel#statoBadge[stato="attiva"]   { background: #E8F5E9; color: #1B5E20; }
QLabel#statoBadge[stato="inattiva"] { background: #F5F5F5; color: #616161; }
QLabel#statoBadge[stato="aperta"]   { background: #E3F2FD; color: #0D47A1; }
QLabel#statoBadge[stato="chiusa"]   { background: #FFF3E0; color: #BF360C; }
