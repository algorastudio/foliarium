/* Stile "Blu Savoia" - Versione ottimizzata con tab abbreviati */
QWidget {
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 10pt;
    color: #212529;
}

QMainWindow, QDialog {
    background-color: #F8F9FA;
}

QGroupBox {
    font-weight: bold;
    border: 1px solid #D3D3D3;
    border-radius: 8px;
    margin-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    left: 10px;
}

QLineEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 5px;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QComboBox:focus {
    border-color: #357EC7;
}

QPushButton {
    background-color: #357EC7;
    color: white;
    font-weight: bold;
    border: none;
    border-radius: 4px;
    padding: 8px 12px;
    min-width: 100px;
}

QPushButton:hover {
    background-color: #2a6ead;
}

QPushButton:pressed {
    background-color: #215a8c;
}

QPushButton:disabled {
    background-color: #A9A9A9;
    color: #E0E0E0;
}

QTabWidget::pane {
    border-top: 2px solid #D3D3D3;
    padding: 10px;
    background-color: #FFFFFF;
}

/* TAB OTTIMIZZATI CON GRASSETTO */
QTabBar::tab {
    background: #E9ECEF;
    border: 1px solid #D3D3D3;
    border-bottom: none;
    /* Padding bilanciato per i nomi abbreviati */
    padding: 10px 18px;
    /* Larghezza minima appropriata per tab corti */
    min-width: 70px;
    /* Altezza uniforme */
    min-height: 20px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    /* Spazio tra i tab */
    margin-right: 2px;
    /* Allineamento centrale del testo */
    text-align: center;
}

QTabBar::tab:selected {
    background: #FFFFFF;
    border-color: #D3D3D3;
    /* Ripristina il grassetto per il tab selezionato */
    font-weight: bold;
    /* Colore blu per evidenziare */
    color: #357EC7;
    /* Bordo superiore colorato */
    border-top: 3px solid #357EC7;
    /* Compensa il bordo più spesso */
    padding-top: 8px;
}

QTabBar::tab:hover:!selected {
    background: #F0F0F0;
    /* Colore più scuro al passaggio del mouse */
    color: #357EC7;
}

/* Differenziazione per tab principali e sotto-tab */
/* Tab principali - più spaziosi */
QTabWidget > QTabBar::tab {
    min-width: 90px;
    padding: 10px 20px;
}

/* Sotto-tab - più compatti */
QTabWidget QTabWidget QTabBar::tab {
    min-width: 70px;
    padding: 8px 15px;
    font-size: 9pt;
}

/* Stile specifico per i tab con icone emoji */
QTabBar::tab[text*="🏠"], 
QTabBar::tab[text*="🔍"], 
QTabBar::tab[text*="📤"] {
    /* Padding extra per bilanciare le icone */
    padding-left: 15px;
    padding-right: 15px;
}

QTableWidget {
    border: 1px solid #D3D3D3;
    gridline-color: #E0E0E0;
    background-color: #FFFFFF;
}

QHeaderView::section {
    background-color: #E6F7FF;
    padding: 5px;
    border: 1px solid #D3D3D3;
    font-weight: bold;
}

QTableWidget::item:selected {
    background-color: #7FB3D5;
    color: white;
}

/* Stile per i pulsanti nei tab (come "Aggiorna Statistiche Comuni") */
QTabWidget QPushButton {
    padding: 6px 12px;
    min-height: 30px;
}

/* Migliora l'aspetto dei tooltip */
QToolTip {
    background-color: #FFFBDD;
    border: 1px solid #D3D3D3;
    padding: 5px;
    border-radius: 3px;
    color: #000000;
}
/* === TOPBAR & SIDEBAR v1.5.0 === */
#topBar {
    background: #FFFFFF;
    border-bottom: 1px solid #C9D6DF;
    min-height: 48px;
    max-height: 48px;
}
#appTitle { font-size: 15px; font-weight: bold; color: #212529; }
#dbIndicator { font-size: 11px; color: #6C757D; }
#userLabel { font-size: 12px; color: #212529; }
#roleChip[role="admin"]        { background: #FDEDED; color: #B00020; border-radius: 10px; padding: 2px 8px; font-size: 11px; }
#roleChip[role="archivista"]   { background: #DBE9F5; color: #3A6E99; border-radius: 10px; padding: 2px 8px; font-size: 11px; }
#roleChip[role="consultatore"] { background: #E9ECEF; color: #6C757D; border-radius: 10px; padding: 2px 8px; font-size: 11px; }
#logoutButton { background: transparent; border: 1px solid #C9D6DF; border-radius: 4px; padding: 4px 12px; color: #212529; font-size: 12px; }
#logoutButton:hover { background: #E9EEF2; border-color: #7FB3D5; }
#sidebar { background: #FFFFFF; border-right: 1px solid #C9D6DF; min-width: 220px; max-width: 220px; }
#sectionLabel { color: #9EB3C4; font-size: 10px; font-weight: bold; text-transform: uppercase; padding: 12px 16px 4px 16px; background: transparent; }
QPushButton#navButton { text-align: left; padding: 8px 16px; border: none; border-radius: 6px; margin: 1px 8px; background: transparent; color: #212529; font-size: 13px; }
QPushButton#navButton:hover { background: #E9EEF2; }
QPushButton#navButton[active="true"] { background: #DBE9F5; color: #3A6E99; font-weight: bold; border-left: 3px solid #3A6E99; }
QStackedWidget { background: #F8F9FA; }
